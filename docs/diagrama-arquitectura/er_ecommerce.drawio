        <mxCell id="er-glue-n_usr" parent="er-glue-1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#8C6D00;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;⚠ Grano: 1 fila por (usuario, dirección)&lt;/b&gt;&lt;br&gt;La ingesta hace LEFT JOIN usuarios–direcciones, así que &lt;b&gt;id&lt;/b&gt; se repite si un usuario tiene varias direcciones. Las consultas primero deduplican (CTE &lt;i&gt;usuarios_unicos&lt;/i&gt;, GROUP BY id)." vertex="1">
          <mxGeometry x="40" y="350" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="er-glue-n_prod" parent="er-glue-1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#8C6D00;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;categorias va desnormalizada&lt;/b&gt;&lt;br&gt;La ingesta de productos hace JOIN con categorias y guarda &lt;b&gt;categoria_nombre&lt;/b&gt; en cada fila. Por eso el catálogo no necesita una tabla categorias." vertex="1">
          <mxGeometry x="1280" y="100" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="er-glue-n_dir" parent="er-glue-1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#8C6D00;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;direcciones&lt;/b&gt; también va aplanada: calle, ciudad y país vienen como columnas de usuarios." vertex="1">
