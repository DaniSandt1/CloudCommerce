        <mxCell id="er-glue-n_views" parent="er-glue-1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F6F1FF;strokeColor=#8C4FFF;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Vistas ≠ tablas.&lt;/b&gt; Cada ingesta agrega un archivo nuevo en S3; las vistas leen solo el último: WHERE &quot;$path&quot; = MAX(&quot;$path&quot;)." vertex="1">
