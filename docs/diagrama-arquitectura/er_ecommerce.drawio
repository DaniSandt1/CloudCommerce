        <mxCell id="er-glue-v_prod_r1" parent="er-glue-v_prod" style="text;html=1;whiteSpace=wrap;strokeColor=none;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;align=left;spacingLeft=8;fontColor=#232F3E;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="categoria_id · categoria_nombre" vertex="1">
