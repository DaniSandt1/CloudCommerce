# IP privada de la MV BD (ver DEPLOYMENT.md Parte E) — no el nombre del contenedor,
# la MV Ingesta es una instancia EC2 separada.
MONGODB_URI=mongodb://<IP-PRIVADA-MV-BD>:27017/pedidos_db

S3_BUCKET_NAME=cloudcommerce-datalake
S3_PREFIX=pedidos

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
