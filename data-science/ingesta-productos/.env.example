# IP privada de la MV Backend (ver DEPLOYMENT.md) — no el nombre del contenedor,
# la MV Ingesta es una instancia EC2 separada.
DB_HOST=<IP-PRIVADA-MV-BACKEND>
DB_PORT=3306
DB_USER=productos_user
DB_PASSWORD=productos_pass
DB_NAME=productos_db

S3_BUCKET_NAME=cloudcommerce-datalake
S3_PREFIX=productos

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
